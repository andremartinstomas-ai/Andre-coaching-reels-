 "saetze": [
  {
   "text": "Schlaf und Stress verbessern, definitiv S oder A -Tier, kommt natürlich immer drauf an, woher der Schmerz kommt,",
   "start": 2.320000000000003,
   "ende": 8.9
  },
  {
   "text": "also welchen Ursprungs der Schmerz ist.",
   "start": 9.78,
   "ende": 11.84
  },
  {
   "text": "Deswegen will ich mich da nicht festsetzen, kann S -Tier sein, kann auch A -Tier sein.",
   "start": 13.360000000000007,
   "ende": 18.16
  },
  {
   "text": "Den?",
   "start": 19.28,
   "ende": 19.52
  },
  {
   "text": "Den würde ich eher auf B -Tier packen, kann Schmerz lindern, kann aber auch in manchen Fällen den Schmerz verstärken.",
   "start": 20.76,
   "ende": 27.96
  },
  {
   "text": "Deswegen als einzige Intervention definitiv nur B -Tier, sonst ergänzend kann das dem ein oder anderen helfen, vor allem im Büroalltag.",
   "start": 27.96,
   "ende": 37.38
  },
  {
   "text": "Akupunktur?",
   "start": 37.82,
   "ende": 38.46
  },
  {
   "text": "Akupunktur würde ich eher auf C -Tier packen, ist auch als alleinige Intervention nicht das hilfreichste und die Evidenz dafür ist auch eher bescheiden.",
   "start": 40.18,
   "ende": 52.32
  },
  {
   "text": "Deswegen lieber rein in die Bewegung und raus aus der Passivität.",
   "start": 53.519999999999996,
   "ende": 57.14
  },
  {
   "text": "Jegliche Art von Bandagen, Rücken, Knie oder Stutzgürtel?",
