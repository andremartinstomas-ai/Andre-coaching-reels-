 "saetze": [
  {
   "text": "Wie beende ich jetzt das Video,",
   "start": 7.680000000000009,
   "ende": 9.42
  },
  {
   "text": "also bei Schmerzen nicht gleich Strukturschaden, Schlaf und so.",
   "start": 11.44,
   "ende": 20.3
  },
  {
   "text": "Ich ziehe auch noch drauf ein.",
   "start": 20.38,
   "ende": 21.94
  },
  {
   "text": "Also bei Schmerzen, versuche das Ganze nicht immer auf den Strukturschaden zu begrenzen, sondern versuche das Ganze als Einheit zu sehen.",
   "start": 25.66,
   "ende": 33.08
  },
  {
   "text": "Wie war dein Schlaf?",
   "start": 33.64,
   "ende": 34.34
  },
  {
   "text": "Wie ist die Ernährung?",
   "start": 34.4,
   "ende": 35.46
  },
  {
   "text": "Wie ist die allgemeine Aktivität?",
   "start": 35.6,
   "ende": 36.82
  },
  {
   "text": "Ist vielleicht Stress mehr geworden?",
   "start": 37.44,
