 "saetze": [
  {
   "text": "Wenn du Nackenschmerzen hast, dann bleib dran.",
   "start": 0.7800000000000002,
   "ende": 4.12
  },
  {
   "text": "Oft denken wir Menschen, dass Schmerzen mit Strukturschäden korreliert.",
   "start": 13.360000000000001,
   "ende": 19.0
  },
  {
   "text": "Heißt,",
   "start": 19.92,
   "ende": 20.52
  },
  {
   "text": "dass, ja, desto mehr Schmerz, desto mehr Schaden da ist.",
   "start": 21.34,
   "ende": 23.9
  },
  {
   "text": "Jedoch hat man in Studien und vor allem auch in anderen Beobachtungen",
   "start": 24.36,
   "ende": 27.96
  },
  {
   "text": "Jedoch hat man in Studien herausfinden können, dass Schmerz nicht immer gleich bedeutet, dass ein Strukturschaden vorhanden ist oder dass der Strukturschaden nicht der stärkste Faktor oder Treiber für Schmerz ist.",
   "start": 29.18,
   "ende": 49.1
  },
  {
   "text": "Schmerz ist multifaktoriell.",
   "start": 49.8,
   "ende": 51.3
  },
  {
   "text": "Er kann zurückzuführen sein auf Stress, auf Schlaf, auf Ernährung, auf allgemein psychobio, soziale Faktoren und hat ziemlich viele Einflüsse.",
   "start": 51.46,
   "ende": 62.54
  },
  {
   "text": "Deswegen als Gedankentipp bei Schmerz nicht direkt denken, dass etwas kaputt ist, sondern versuchen andere...",
   "start": 71.08,
   "ende": 77.5
  },
  {
   "text": "Also bei Schmerzen nicht direkt die Alarmglocken läuten lassen.",
   "start": 104.86000000000001,
   "ende": 109.52
  }
 ]
