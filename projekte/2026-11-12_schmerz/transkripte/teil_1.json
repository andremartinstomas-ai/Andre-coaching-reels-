 "saetze": [
  {
   "text": "Womit habt ihr am meisten im Alltag zu tun?",
   "start": 0.6199999999999934,
   "ende": 2.42
  },
  {
   "text": "Mit was für Schmerzen?",
   "start": 2.66,
   "ende": 3.74
  },
  {
   "text": "Ne, das war scheiße.",
   "start": 3.8,
   "ende": 7.0
  },
  {
   "text": "Für mehr rund ums Thema Schmerzen und Training lasst gerne ein Follow da und schreibt mal gerne in die Kommentare",
   "start": 20.12,
   "ende": 25.48
  },
  {
   "text": "wo es euch am meisten wehtut.",
   "start": 26.499999999999996,
   "ende": 28.34
  },
  {
   "text": "Machen wir gar nichts.",
   "start": 29.76,
   "ende": 31.0
  },
  {
   "text": "Wie soll ich das beenden?",
   "start": 31.36,
   "ende": 32.46
  },
  {
   "text": "Was soll ich in die Kommentare schreiben?",
   "start": 32.86,
   "ende": 34.12
  },
  {
   "text": "Also es geht ja darum wie ihr mit Schmerzen umgeht, was ihr über Schmerzen denkt.",
